{
  "name": "moa-mixer",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build --config vite.mixer.config.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "build:pipe": "tsc --noEmit && vite build --config vite.pipe.config.ts",
    "build:lynch": "tsc --noEmit && vite build --config vite.lynch.config.ts",
    "build:df2": "tsc --noEmit && vite build --config vite.df2.config.ts",
    "build:duo": "tsc --noEmit && vite build --config vite.duo.config.ts",
    "build:seq": "tsc --noEmit && vite build --config vite.seq.config.ts",
    "build:synth": "tsc --noEmit && vite build --config vite.synth.config.ts",
    "build:poly": "tsc --noEmit && vite build --config vite.poly.config.ts",
    "build:drums": "tsc --noEmit && vite build --config vite.drums.config.ts",
    "build:records": "tsc --noEmit && vite build --config vite.records.config.ts",
    "build:reverb": "tsc --noEmit && vite build --config vite.reverb.config.ts",
    "build:delay": "tsc --noEmit && vite build --config vite.delay.config.ts",
    "build:ouroboros": "tsc --noEmit && vite build --config vite.ouroboros.config.ts",
    "build:buscomp": "tsc --noEmit && vite build --config vite.buscomp.config.ts",
    "build:granular": "tsc --noEmit && vite build --config vite.granular.config.ts",
    "build:2600": "tsc --noEmit && vite build --config vite.2600.config.ts",
    "build:bass": "tsc --noEmit && vite build --config vite.bass.config.ts",
    "build:guitar": "tsc --noEmit && vite build --config vite.guitar.config.ts",
    "build:kit": "tsc --noEmit && vite build --config vite.kit.config.ts",
    "build:band": "tsc --noEmit && vite build --config vite.band.config.ts",
    "build:mpc": "tsc --noEmit && vite build --config vite.mpc.config.ts",
    "build:unicorn": "tsc --noEmit && vite build --config vite.unicorn.config.ts"
  },
  "devDependencies": {
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.3"
